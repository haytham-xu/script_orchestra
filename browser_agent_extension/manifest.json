{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "0.2.0",
  "description": "Thin terminal for script_orchestra: collects browser-side data and triggers backend features.",
  "permissions": [
    "tabs",
    "activeTab",
    "alarms",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:50001/*",
    "http://localhost:50001/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
